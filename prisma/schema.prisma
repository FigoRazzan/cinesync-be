// ============================================================
// Schema Prisma untuk Cine-Sync
// Sistem Manajemen Bioskop & POS (B2B + B2C)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUM
// ============================================================

/// Peran pengguna dalam sistem
enum Role {
  ADMIN    // Akses penuh: kelola platform, kontrak, langganan
  PRODUCER // Pemilik film, membuat pengajuan kontrak tayang
  USER     // Pelanggan platform streaming
}

/// Status kontrak B2B
enum ContractStatus {
  DRAFT     // Baru dibuat oleh Manajer, belum dikirim
  PENDING   // Sudah dikirim, menunggu persetujuan Distributor
  ACTIVE    // Disetujui, film sedang tayang
  EXPIRED   // Masa tayang sudah berakhir
  REJECTED  // Ditolak oleh Distributor
}

/// Status langganan user
enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELED
}

/// Tipe item dalam transaksi POS
enum ItemType {
  TICKET // Tiket bioskop
  FNB    // Food & Beverage
}

/// Status kursi bioskop
enum SeatStatus {
  AVAILABLE // Kursi tersedia
  BOOKED    // Kursi sudah dipesan
}

// ============================================================
// MODEL USER
// ============================================================

/// Tabel pengguna sistem (Manajer, Kasir, Distributor)
model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String   // Disimpan dalam bentuk hash (bcrypt)
  role      Role

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relasi: Producer bisa memiliki banyak kontrak
  contracts    Contract[]    @relation("ProducerContracts")

  // Relasi transaksi yang dilakukan user
  transactions Transaction[] @relation("UserTransactions")

  // Relasi langganan user
  subscriptions Subscription[]

  // Relasi film yang diunggah producer
  producedMovies Movie[] @relation("MovieProducer")

  @@map("users")
}

// ============================================================
// MODEL MOVIE
// ============================================================

/// Tabel film - metadata diambil dari TMDB API
model Movie {
  id          String  @id @default(uuid())
  tmdbId      Int?    @unique // Opsional: ID film dari TMDB API
  title       String
  overview    String? @db.Text
  posterPath  String? // URL poster dari TMDB
  backdropPath String?
  releaseDate DateTime?
  genres      String[] // Array genre film
  runtime     Int?     // Durasi film dalam menit
  rating      Float?   // Rating TMDB (0-10)

  // Harga lisensi konten (opsional untuk skenario streaming)
  licensePrice Decimal? @db.Decimal(12, 2)

  // Film milik producer tertentu
  ownerProducerId String?
  ownerProducer   User?   @relation("MovieProducer", fields: [ownerProducerId], references: [id])

  isPublished Boolean @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relasi: Film bisa memiliki banyak kontrak
  contracts   Contract[]

  // Relasi: Film bisa memiliki banyak kursi
  seats       Seat[]

  @@map("movies")
}

// ============================================================
// MODEL CONTRACT (B2B)
// ============================================================

/// Tabel kontrak antara Bioskop (Manajer) dan Distributor
model Contract {
  id String @id @default(uuid())

  // Relasi ke Film
  movieId String
  movie   Movie  @relation(fields: [movieId], references: [id])

  // Relasi ke Producer (User dengan role PRODUCER)
  producerId String
  producer   User   @relation("ProducerContracts", fields: [producerId], references: [id])

  // Persentase bagi hasil (0-100)
  // Contoh: cinemaShare = 60, distributorShare = 40 (total harus 100)
  platformShare Decimal @db.Decimal(5, 2) // Persentase untuk platform
  producerShare Decimal @db.Decimal(5, 2) // Persentase untuk producer

  // Tanggal tayang
  startDate DateTime
  endDate   DateTime

  status ContractStatus @default(DRAFT)

  // Path file PDF kontrak yang di-generate oleh Puppeteer
  pdfPath String?

  // Catatan tambahan (opsional)
  notes String? @db.Text

  // Timestamp persetujuan oleh Distributor
  approvedAt DateTime?
  rejectedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relasi ke RevenueLedger
  revenueEntries RevenueLedger[]

  // Constraint: Jumlah cinemaShare + distributorShare harus 100
  // (validasi dilakukan di level aplikasi/service)

  @@map("contracts")
}

// ============================================================
// MODEL SEAT (Kursi Bioskop)
// ============================================================

/// Tabel kursi bioskop per film yang sedang tayang
model Seat {
  id     String @id @default(uuid())

  // Relasi ke Film
  movieId String
  movie   Movie  @relation(fields: [movieId], references: [id])

  // Nomor kursi (contoh: A1, B5, C12)
  seatNumber String
  row        String // Baris (A, B, C, ...)
  number     Int    // Nomor dalam baris (1, 2, 3, ...)

  status SeatStatus @default(AVAILABLE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relasi ke detail transaksi
  transactionDetails TransactionDetail[]

  // Setiap kursi unik per film
  @@unique([movieId, seatNumber])
  @@map("seats")
}

// ============================================================
// MODEL TRANSACTION (POS B2C)
// ============================================================

/// Tabel transaksi penjualan tiket dan F&B oleh Kasir
model Transaction {
  id String @id @default(uuid())

  // Relasi ke user yang memproses transaksi
  userId String
  user   User   @relation("UserTransactions", fields: [userId], references: [id])

  // Total harga DIHITUNG OLEH BACKEND, bukan dari frontend
  // Ini untuk mencegah Price Tampering
  totalAmount Decimal @db.Decimal(12, 2)

  // Nama/identitas penonton (opsional)
  customerName String?

  // Metode pembayaran
  paymentMethod String @default("CASH")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relasi ke detail item transaksi
  details TransactionDetail[]

  // Relasi ke ledger pendapatan
  revenueEntries RevenueLedger[]

  @@map("transactions")
}

// ============================================================
// MODEL TRANSACTION DETAIL
// ============================================================

/// Tabel detail item per transaksi (tiket atau F&B)
model TransactionDetail {
  id String @id @default(uuid())

  // Relasi ke Transaksi induk
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  // Tipe item (TICKET atau FNB)
  itemType ItemType

  // Nama item (contoh: "Tiket Avengers", "Popcorn Large")
  itemName String

  // Harga satuan diambil dari DATABASE, bukan dari frontend
  unitPrice Decimal @db.Decimal(12, 2)

  quantity Int

  // Subtotal = unitPrice * quantity (dihitung oleh backend)
  subtotal Decimal @db.Decimal(12, 2)

  // Relasi ke Kursi (hanya jika itemType = TICKET)
  seatId String?
  seat   Seat?   @relation(fields: [seatId], references: [id])

  // Relasi ke Film (untuk keperluan revenue split)
  movieId String?

  createdAt DateTime @default(now())

  @@map("transaction_details")
}

// ============================================================
// MODEL REVENUE LEDGER
// ============================================================

/// Buku besar pencatatan pembagian pendapatan per transaksi tiket
/// Otomatis terisi saat tiket terjual berdasarkan persentase di kontrak aktif
model RevenueLedger {
  id String @id @default(uuid())

  // Relasi ke Kontrak yang menjadi dasar perhitungan bagi hasil
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id])

  // Relasi ke Transaksi yang memicu pencatatan ini
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  // Total pendapatan dari tiket pada transaksi ini
  grossAmount Decimal @db.Decimal(12, 2)

  // Bagian pendapatan untuk platform
  platformAmount Decimal @db.Decimal(12, 2)

  // Bagian pendapatan untuk producer
  producerAmount Decimal @db.Decimal(12, 2)

  // Persentase yang digunakan saat transaksi (snapshot dari kontrak)
  // Disimpan sebagai snapshot agar tidak berubah jika kontrak diupdate
  platformShareSnapshot Decimal @db.Decimal(5, 2)
  producerShareSnapshot Decimal @db.Decimal(5, 2)

  createdAt DateTime @default(now())

  @@map("revenue_ledger")
}

// ============================================================
// MODEL PLAN & SUBSCRIPTION (B2C Streaming)
// ============================================================

model Plan {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  price       Decimal  @db.Decimal(12, 2)
  durationDays Int
  isActive    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id        String   @id @default(uuid())
  userId    String
  planId    String
  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime @default(now())
  endDate   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  plan Plan @relation(fields: [planId], references: [id])

  @@index([userId, status])
  @@map("subscriptions")
}
